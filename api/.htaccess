# Pass Authorization header to PHP (some Apache/LiteSpeed setups strip it)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Finbro M2M producer endpoints (clean paths → front controller)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^v1/integrations/finbro/users/status/?$ v1/integrations/finbro/index.php?finbro_route=users/status [L,QSA]
  RewriteRule ^v1/integrations/finbro/hours/by-user/?$ v1/integrations/finbro/index.php?finbro_route=hours/by-user [L,QSA]
  RewriteRule ^v1/integrations/finbro/hours/?$ v1/integrations/finbro/index.php?finbro_route=hours [L,QSA]
</IfModule>

# CORS fallback on LiteSpeed responses (including 403 pages). If PHP already
# set CORS headers (via backend/config/cors.php), do not overwrite them.
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "https://bugs.bugricer.com" "expr=-z %{resp:Access-Control-Allow-Origin}"
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" "expr=-z %{resp:Access-Control-Allow-Methods}"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, X-Impersonate-User, X-User-Id, Cache-Control, Pragma" "expr=-z %{resp:Access-Control-Allow-Headers}"
  Header always set Access-Control-Max-Age "86400" "expr=-z %{resp:Access-Control-Max-Age}"
  Header always set Vary "Origin"
</IfModule>
