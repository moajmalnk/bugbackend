# Pass Authorization header to PHP (some Apache/LiteSpeed setups strip it)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Finbro M2M producer endpoints (clean paths → front controller)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^v1/integrations/finbro/users/status/?$ v1/integrations/finbro/index.php?finbro_route=users/status [L,QSA]
  RewriteRule ^v1/integrations/finbro/hours/by-user/?$ v1/integrations/finbro/index.php?finbro_route=hours/by-user [L,QSA]
  RewriteRule ^v1/integrations/finbro/hours/?$ v1/integrations/finbro/index.php?finbro_route=hours [L,QSA]
</IfModule>

# CORS on every LiteSpeed response, including 403 error pages (browsers otherwise
# report "No Access-Control-Allow-Origin" instead of the real 403).
<IfModule mod_headers.c>
  SetEnvIfNoCase Origin "^https://bugs\.bugricer\.com$" CORS_ORIGIN=$0
  SetEnvIfNoCase Origin "^http://(localhost|127\.0\.0\.1)(:[0-9]+)?$" CORS_ORIGIN=$0
  Header always set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
  Header always set Access-Control-Allow-Origin "https://bugs.bugricer.com" env=!CORS_ORIGIN
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin, X-Impersonate-User, X-User-Id, Cache-Control, Pragma"
  Header always set Access-Control-Max-Age "86400"
  Header always set Vary "Origin"
</IfModule>
