GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://bugbackend.bugricer.com/api/oauth/callback

# BugRicer Notify API - WhatsApp notifications (optional)
WHATSAPP_API_KEY=your-notify-api-key
WHATSAPP_ADMIN_NUMBERS=91XXXXXXXXXX

# Outgoing email (Gmail: use App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=BugRicer

# Firebase Admin SDK (FCM push) — use server file path on Hostinger
FIREBASE_SERVICE_ACCOUNT_PATH=/home/USER/domains/bugricer.com/public_html/bugbackend/config/firebase-service-account.json

# Daily project deadline / timeline reminders (HTTP cron token)
DEADLINE_REMINDER_SECRET=change-me-to-a-long-random-secret

# Finbro M2M integration (shared secret; must match Finbro BUGRICER_INTEGRATION_TOKEN).
# Never expose in the browser. Finbro calls BugRicer API at:
#   BUGRICER_API_BASE_URL=https://bugbackend.bugricer.com/api
# Paths: /v1/integrations/finbro/users/status
#        /v1/integrations/finbro/hours
#        /v1/integrations/finbro/hours/by-user
FINBRO_INTEGRATION_TOKEN=change-me-to-a-long-random-shared-secret

